  "feature": "Hybrid Lakebase Search over the operational text column app.creatives_search.description",
  "halves": {
    "full_text": {
      "extension": "lakebase_text",
      "index": "app.creatives_search_bm25 (lakebase_bm25 on search_tsv)",
      "operator": "search_tsv <@> to_bm25query(...)"
