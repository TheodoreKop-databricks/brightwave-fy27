  "display_name": "Brightwave Unity AI Gateway - Exec Usage",
  "path": "/Users/theodore.kop@databricks.com/Brightwave Unity AI Gateway - Exec Usage.lvdash.json",
  "source_table": "system.ai_gateway.usage",
  "workspace_id": "7474647541759877",
  "note": "Exec usage dashboard over Unity AI Gateway: app model service, coding agent (shared + own bonus endpoint), Slack MCP, guardrail judge; plus the $0.05 Block-usage budget.",
  "serialized_dashboard": {
    "datasets": [
      {
        "name": "ds_gw",
        "displayName": "Unity AI Gateway usage",
        "queryLines": [
          "SELECT DATE_TRUNC('DAY', event_time) AS day,\n",
          "  CASE WHEN service_name='brightwave_techsummit27_catalog.brightwave.campaign_desk_llm' THEN 'App - Campaign Desk'\n",
          "       WHEN service_name='brightwave_techsummit27_catalog.brightwave.campaign_desk_codex' THEN 'Coding Agent - own endpoint (bonus)'\n",
          "       WHEN service_name='system.ai.gpt-5-6-luna' THEN 'Coding Agent - Codex (shared)'\n",
          "       WHEN service_name='system.ai.slack' THEN 'MCP - Slack'\n",
          "       WHEN service_name='system.ai.gpt-5-2' THEN 'Guardrail Judge'\n",
          "       ELSE service_name END AS surface,\n",
          "  service_name, service_type,\n",
          "  COUNT(*) AS calls,\n",
          "  COALESCE(SUM(total_tokens),0) AS tokens\n",
          "FROM usage\n",
          "WHERE workspace_id='7474647541759877' AND event_time > now() - INTERVAL 14 DAYS\n",
          "GROUP BY 1,2,3,4"
        ],
        "columns": [
          {
            "displayName": "Total Calls",
            "description": "Gateway calls",
            "expression": "SUM(`calls`)"
          },
          {
            "displayName": "Total Tokens",
            "description": "Total tokens",
            "expression": "SUM(`tokens`)"
          },
          {
            "displayName": "Governed Surfaces",
            "description": "Distinct governed surfaces",
            "expression": "COUNT(DISTINCT `surface`)"
          },
          {
            "displayName": "Coding Agent Tokens",
            "description": "Tokens from the coding agent (shared + own endpoint)",
            "expression": "SUM(CASE WHEN `surface` LIKE 'Coding Agent%' THEN `tokens` ELSE 0 END)"
          }
        ]
      }
    ],
    "pages": [
